{
  "name": "@express-app/server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API server application",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/platform/platform-worker.js",
    "dev": "nodemon --legacy-watch src/server.js",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "prisma generate && prisma migrate deploy && RUN_INTEGRATION_TESTS=true RUN_REDIS_INTEGRATION_TESTS=true vitest run --dir tests/integration",
    "test:postgres": "prisma generate && prisma migrate deploy && RUN_INTEGRATION_TESTS=true vitest run --dir tests/integration/database",
    "test:redis": "RUN_REDIS_INTEGRATION_TESTS=true vitest run --dir tests/integration/cache",
    "test:auth": "vitest run --dir tests/integration/auth",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:coverage": "vitest run --coverage"
  },
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/node": "^10.70.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.9",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "pm2": "^7.0.3",
    "prom-client": "^15.1.0",
    "redis": "^6.2.0",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
