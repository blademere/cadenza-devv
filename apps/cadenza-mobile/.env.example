# API base URL. For physical devices, use the development computer LAN IP.
EXPO_PUBLIC_MOBILE_API_URL=

# Use mock learning data only for local UI development; use "live" for backend data.
EXPO_PUBLIC_MOBILE_DATA_MODE=mock

# Google OAuth client IDs (IDs are public; never put client secrets in the mobile app).
# Create Android and iOS OAuth clients for site.cadenza.mobile and use your existing
# Web application OAuth client ID as the webClientId. The server must allow all
# client IDs used by this app in OAUTH_GOOGLE_MOBILE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
