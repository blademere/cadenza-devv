# Leave blank to use the platform default:
# Android emulator: http://10.0.2.2:3000/api/v1/cadenza-mobile
# iOS simulator:    http://localhost:3000/api/v1/cadenza-mobile
# Physical device:  set the development computer LAN IP, for example:
# http://192.168.1.20:3000/api/v1/cadenza-mobile
EXPO_PUBLIC_MOBILE_API_URL=

# Use local sample learning data while those backend endpoints are pending.
# Real account login still calls the backend.
EXPO_PUBLIC_MOBILE_DATA_MODE=mock
