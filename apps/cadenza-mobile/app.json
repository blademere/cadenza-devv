{
  "expo": {
    "name": "Cadenza",
    "slug": "Cadenza",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/logo.png",
    "ios": {
      "bundleIdentifier": "com.cadenza.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cadenza.mobile",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleWebClientId": "539575657827-l47dbsjueh6fp9noec8pqiughlskl5bv.apps.googleusercontent.com",
      "googleAndroidClientId": "539575657827-0mjv7h6n2rjbislh77ut9j83l1k78kls.apps.googleusercontent.com",
      "googleIosClientId": "539575657827-l47dbsjueh6fp9noec8pqiughlskl5bv.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "15ed1e1b-a7d5-4b15-8ef4-fe5bdc5a08d4"
      }
    },
    "owner": "blademeresuico10",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/15ed1e1b-a7d5-4b15-8ef4-fe5bdc5a08d4"
    }
  }
}
