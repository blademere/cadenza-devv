# Same-origin development: Vite proxies /api to the local Express server.
VITE_API_BASE_URL=/api/v1

# Vite dev-server proxy target.
# When Vite and Express run in the same development container/host, keep localhost.
# When Vite runs in a separate container, use the Express service hostname instead.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Codespaces / split frontend-backend deployments:
# Set VITE_API_BASE_URL to the HTTPS backend origin so browser cookies are
# stored and sent directly to the API host instead of being hidden behind
# the frontend Vite proxy.
# Example:
# VITE_API_BASE_URL=https://<codespace-backend>.app.github.dev/api/v1
