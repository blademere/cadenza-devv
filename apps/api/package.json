{
  "name": "@cadenza-app/api",
  "version": "1.0.0",
  "private": true,
  "description": "Express API application",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "predev": "npm run prisma:generate",
    "dev": "nodemon --legacy-watch src/server.js",
    "prestart": "npm run prisma:generate",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "npm run prisma:generate && npm run prisma:migrate:deploy && RUN_INTEGRATION_TESTS=true RUN_REDIS_INTEGRATION_TESTS=true vitest run --dir tests/integration",
    "test:postgres": "npm run prisma:generate && npm run prisma:migrate:deploy && RUN_INTEGRATION_TESTS=true RUN_REDIS_INTEGRATION_TESTS=true vitest run --dir tests/integration/database",
    "test:redis": "RUN_REDIS_INTEGRATION_TESTS=true vitest run --dir tests/integration/cache",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:coverage": "vitest run --coverage",
    "openapi:lint": "redocly lint openapi/openapi.yaml",
    "openapi:bundle": "redocly bundle openapi/openapi.yaml -o openapi/dist/openapi.yaml",
    "openapi:build": "npm run openapi:lint && npm run openapi:bundle",
    "prisma:generate": "prisma generate --config ./prisma.config.ts",
    "prisma:validate": "prisma validate --config ./prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config ./prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config ./prisma.config.ts",
    "db:seed": "node scripts/db-seed.js --app=all",
    "db:setup": "npm run prisma:generate && npm run prisma:migrate && node scripts/db-seed.js --app=all --profile=development",
    "db:backup": "node scripts/db-backup.cjs",
    "db:restore": "node scripts/db-restore.cjs",
    "validate:architecture": "node scripts/validate-architecture.cjs",
    "validate:authorization": "node scripts/validate-authorization.cjs",
    "validate:migrations": "node scripts/validate-migrations.cjs",
    "db:seed:platform": "node scripts/db-seed.js --app=platform",
    "db:seed:all": "node scripts/db-seed.js --app=all",
    "db:reset": "prisma migrate reset --config ./prisma.config.ts --force && node scripts/db-seed.js --app=all --profile=development",
    "db:seed:all:development": "node scripts/db-seed.js --app=all --profile=development",
    "build": "npm run prisma:generate && node --check src/server.js"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^10.70.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.4.0",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "pm2": "^7.0.3",
    "prom-client": "^15.1.0",
    "redis": "^6.2.0",
    "resend": "^6.18.1",
    "swagger-ui-express": "5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "^2.47.0",
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "msgpackr-extract@3.0.4": true,
    "@scarf/scarf@1.4.0": false
  }
}
