model OboProfessional {
  id                 String @id @default(uuid())
  appId              String
  personId           String
  registrationNumber String
  prcId              String?
  ptrNumber          String?
  professionalRole   String?

  status                String                                @default("PENDING_VERIFICATION")
  verifiedByUserId      Int?
  verifiedAt            DateTime?
  verificationReason    String?
  app                   App                                   @relation(fields: [appId], references: [id], onDelete: Restrict)
  person                Person                                @relation(fields: [personId], references: [id], onDelete: Restrict)
  verifiedBy            User?                                 @relation("OboProfessionalVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verificationDecisions OboProfessionalVerificationDecision[]
  createdAt             DateTime                              @default(now())
  updatedAt             DateTime                              @updatedAt

  @@index([appId])
  @@index([appId, status])
  @@index([appId, ptrNumber])
  @@index([appId, professionalRole])
  @@unique([appId, personId])
  @@unique([appId, registrationNumber])
  @@unique([appId, prcId])
  @@unique([id, appId])
}
