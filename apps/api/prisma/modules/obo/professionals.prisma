model OboProfessional {
  id                 String @id @default(uuid())
  personId           String @unique
  userId             Int?   @unique
  registrationNumber String @unique
  prcId              String? @unique
  ptrNumber          String?

  status                String                                @default("PENDING_VERIFICATION")
  verifiedByUserId      Int?
  verifiedAt            DateTime?
  verificationReason    String?
  person                Person                                @relation(fields: [personId], references: [id], onDelete: Restrict)
  user                  User?                                 @relation("OboProfessionalUser", fields: [userId], references: [id], onDelete: SetNull)
  verifiedBy            User?                                 @relation("OboProfessionalVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  applications          OboPermitApplication[]
  verificationDecisions OboProfessionalVerificationDecision[]
  createdAt             DateTime                              @default(now())
  updatedAt             DateTime                              @updatedAt

  @@index([status])
  @@index([ptrNumber])
}
