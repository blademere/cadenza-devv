model OboPermitApplication {
  id                      String                    @id @default(uuid())
  appId                   String
  referenceNumber         String
  caseId                  String                    @unique
  permitTypeId            String
  clientPersonId          String
  formVersionId           String?
  workflowInstanceId      String?                   @unique
  replacesApplicationId   String?
  formValues              Json
  professionalSnapshots   Json?
  submittedAt             DateTime?
  declinedAt              DateTime?
  declineReason           String?
  acceptedAt              DateTime?
  acceptedByUserId        Int?
  app                     App                       @relation(fields: [appId], references: [id], onDelete: Restrict)
  caseRecord              CaseRecord                @relation(fields: [caseId], references: [id], onDelete: Restrict)
  permitType              OboPermitType             @relation(fields: [permitTypeId], references: [id], onDelete: Restrict)
  clientPerson            Person                    @relation("OboApplicationClient", fields: [clientPersonId], references: [id], onDelete: Restrict)
  workflowInstance        WorkflowInstance?         @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  acceptedBy              User?                     @relation("OboApplicationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  replacedApplication     OboPermitApplication?     @relation("OboPermitApplicationReplacement", fields: [replacesApplicationId], references: [id], onDelete: Restrict)
  replacementApplications OboPermitApplication[]    @relation("OboPermitApplicationReplacement")
  submissionAppointment   OboSubmissionAppointment?
  applicationDocuments    OboPermitApplicationDocument[]
  decisions               OboReceivingDecision[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([appId])
  @@index([appId, clientPersonId, createdAt])
  @@index([appId, permitTypeId])
  @@index([appId, referenceNumber])
  @@index([replacesApplicationId])
  @@index([formVersionId])
  @@unique([appId, referenceNumber])
  @@unique([id, appId])
}
