model OboPermitApplicationDocument {
  id                String               @id @default(uuid())
  applicationId     String
  caseRequirementId String
  documentId        String?
  status            String               @default("PENDING")
  receivedAt        DateTime?
  receivedByUserId  Int?
  verifiedAt        DateTime?
  verifiedByUserId  Int?
  notes             String?
  application       OboPermitApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  caseRequirement   CaseRequirement      @relation(fields: [caseRequirementId], references: [id], onDelete: Cascade)
  document          Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([applicationId, caseRequirementId])
  @@index([applicationId, status])
  @@index([caseRequirementId])
  @@index([documentId])
}