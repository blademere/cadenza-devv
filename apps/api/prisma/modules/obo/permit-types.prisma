model OboPermitType {
  id                      String                     @id @default(uuid())
  appId                   String
  key                     String
  name                    String
  description             String?
  formId                  String?
  isActive                Boolean                    @default(true)
  app                     App                        @relation(fields: [appId], references: [id], onDelete: Restrict)
  applications            OboPermitApplication[]
  requirementAssociations OboPermitTypeRequirement[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([appId])
  @@index([appId, isActive])
  @@index([appId, key])
  @@index([formId])
  @@unique([appId, key])
  @@unique([id, appId])
}

model OboPermitTypeRequirement {
  id            String                @id @default(uuid())
  permitTypeId  String
  requirementId String
  permitType    OboPermitType        @relation(fields: [permitTypeId], references: [id], onDelete: Cascade)
  requirement   RequirementDefinition @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  createdAt     DateTime              @default(now())

  @@unique([permitTypeId, requirementId])
  @@index([permitTypeId])
  @@index([requirementId])
}
