model OboPermitType {
  id           String                 @id @default(uuid())
  key          String                 @unique
  name         String
  description  String?
  formId       String?
  isActive     Boolean                @default(true)
  applications OboPermitApplication[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([isActive])
  @@index([formId])
}
