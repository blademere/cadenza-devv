model CaseType {
  id          String       @id @default(uuid())
  key         String       @unique
  name        String
  description String?
  isActive    Boolean      @default(true)
  cases       CaseRecord[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isActive])
}

model CaseRecord {
  id              String                @id @default(uuid())
  appId           String
  caseNumber      String                @unique
  caseTypeId      String
  title           String
  description     String?
  status          String                @default("DRAFT")
  openedAt        DateTime              @default(now())
  closedAt        DateTime?
  createdByUserId Int?
  metadata        Json?
  app             App                   @relation(fields: [appId], references: [id], onDelete: Restrict)
  caseType        CaseType              @relation(fields: [caseTypeId], references: [id], onDelete: Restrict)
  createdByUser   User?                 @relation("CaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  statusHistory   CaseStatusHistory[]
  participants    CaseParticipant[]
  requirements    CaseRequirement[]
  tasks           Task[]
  oboApplication  OboPermitApplication?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([appId])
  @@index([appId, caseTypeId, status])
  @@index([appId, status, createdAt])
  @@index([createdByUserId])
}

model CaseStatusHistory {
  id              String     @id @default(uuid())
  caseId          String
  fromStatus      String?
  toStatus        String
  reason          String?
  changedByUserId Int?
  metadata        Json?
  caseRecord      CaseRecord @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedByUser   User?      @relation("CaseStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())

  @@index([caseId, createdAt])
  @@index([changedByUserId])
}
