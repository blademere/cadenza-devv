model Task {
  id              String      @id @default(uuid())
  appId           String
  caseId          String?
  title           String
  description     String?
  status          String      @default("OPEN")
  priority        String      @default("NORMAL")
  assigneeUserId  Int?
  createdByUserId Int?
  dueAt           DateTime?
  completedAt     DateTime?
  metadata        Json?
  app             App         @relation(fields: [appId], references: [id], onDelete: Restrict)
  caseRecord      CaseRecord? @relation(fields: [caseId, appId], references: [id, appId], onDelete: SetNull)
  assigneeUser    User?       @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdByUser   User?       @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([appId])
  @@index([appId, caseId, status])
  @@index([appId, assigneeUserId, status])
  @@index([appId, status, dueAt])
}
