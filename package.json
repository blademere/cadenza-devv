{
  "name": "express-app",
  "version": "1.0.0",
  "private": true,
  "description": "Express API and React web application monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently \"npm --workspace @express-app/api run dev\" \"npm --workspace @express-app/web run dev\" \"npm --workspace @express-app/admin-web run dev\"",
    "build": "npm run build:workspaces",
    "build:workspaces": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "node scripts/format-check.cjs",
    "validate:workspaces": "node scripts/validate-workspaces.cjs",
    "validate:dependencies": "node scripts/validate-dependencies.cjs",
    "validate:lockfile": "npm ci --dry-run --ignore-scripts --audit=false",
    "validate:architecture": "npm --workspace @express-app/api run validate:architecture",
    "validate:authorization": "npm --workspace @express-app/api run validate:authorization",
    "validate:migrations": "npm --workspace @express-app/api run validate:migrations",
    "validate": "npm run validate:workspaces && npm run validate:dependencies && npm run validate:lockfile && npm run validate:architecture && npm run validate:authorization && npm run validate:migrations",
    "openapi:lint": "npm --workspace @express-app/api run openapi:lint",
    "openapi:bundle": "npm --workspace @express-app/api run openapi:bundle",
    "openapi:build": "npm --workspace @express-app/api run openapi:build",
    "prisma:generate": "npm --workspace @express-app/api run prisma:generate",
    "prisma:migrate": "npm --workspace @express-app/api run prisma:migrate",
    "prisma:migrate:deploy": "npm --workspace @express-app/api run prisma:migrate:deploy",
    "db:seed": "npm --workspace @express-app/api run db:seed",
    "db:setup": "npm --workspace @express-app/api run db:setup",
    "db:backup": "npm --workspace @express-app/api run db:backup",
    "db:restore": "npm --workspace @express-app/api run db:restore"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/node": "^23.1.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nx": "23.1.3",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "nanoid": ">=3.3.18",
    "js-yaml": "5.2.2",
    "deepmerge-ts": "^8.0.1",
    "mysql2": "^3.22.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "msgpackr-extract@3.0.0": true
  }
}
