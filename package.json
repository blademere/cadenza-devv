{
  "name": "express-app",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/platform/platform-worker.js",
    "dev": "nodemon --legacy-watch src/server.js",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "prisma generate && prisma migrate deploy && RUN_INTEGRATION_TESTS=true RUN_REDIS_INTEGRATION_TESTS=true vitest run --dir tests/integration",
    "test:postgres": "prisma generate && prisma migrate deploy && RUN_INTEGRATION_TESTS=true vitest run --dir tests/integration/database",
    "test:redis": "RUN_REDIS_INTEGRATION_TESTS=true vitest run --dir tests/integration/cache",
    "test:auth": "vitest run --dir tests/integration/auth",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:coverage": "prisma generate && vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@sentry/node": "^10.70.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.9",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "pm2": "^5.3.1",
    "prom-client": "^15.1.3",
    "redis": "^6.2.0",
    "resend": "^6.18.1",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "^7.9.1",
    "eslint": "^10.8.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": ">=3.3.18"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "bcrypt@6.0.0": true,
    "msgpackr-extract@3.0.4": true,
    "@scarf/scarf@1.4.0": true
  }
}
