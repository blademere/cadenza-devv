{
  "name": "cadenza-app",
  "version": "1.0.0",
  "private": true,
  "description": "Express API and React web application monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run-many -t dev --parallel=2",
    "dev:all": "nx run-many -t dev --parallel=2",
    "build": "nx run-many -t build",
    "build:workspaces": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "format": "prettier --write .",
    "format:check": "node scripts/format-check.cjs",
    "validate:workspaces": "node scripts/validate-workspaces.cjs",
    "validate:dependencies": "node scripts/validate-dependencies.cjs",
    "validate:lockfile": "npm ci --dry-run --ignore-scripts --audit=false",
    "validate:architecture": "nx run api:validate:architecture",
    "validate:authorization": "nx run api:validate:authorization",
    "validate:migrations": "nx run api:validate:migrations",
    "validate": "npm run validate:workspaces && npm run validate:dependencies && npm run validate:lockfile && nx run api:validate:architecture && nx run api:validate:authorization && nx run api:validate:migrations",
    "openapi:lint": "nx run api:openapi:lint",
    "openapi:bundle": "nx run api:openapi:bundle",
    "openapi:build": "nx run api:openapi:build",
    "prisma:generate": "nx run api:prisma:generate",
    "prisma:migrate": "nx run api:prisma:migrate",
    "prisma:migrate:deploy": "nx run api:prisma:migrate:deploy",
    "db:seed": "nx run api:db:seed",
    "db:seed:platform": "nx run api:db:seed:platform",
    "db:seed:cadenza": "nx run api:db:seed:cadenza:development",
    "db:seed:cadenza:development": "nx run api:db:seed:cadenza:development",
    "db:setup": "nx run api:db:setup",
    "db:backup": "nx run api:db:backup",
    "db:restore": "nx run api:db:restore",
    "db:seed:all": "nx run api:db:seed:all",
    "db:seed:all:development": "nx run api:db:seed:all:development"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/eslint": "23.3.0",
    "@nx/js": "^23.3.0",
    "@nx/node": "^23.3.0",
    "@nx/react": "^23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.16.18",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "~5.0.5",
    "@vitest/ui": "~5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "jiti": "2.7.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "nx": "23.3.0",
    "prettier": "^3.9.10",
    "tslib": "^2.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "nanoid": ">=3.3.18",
    "js-yaml": "5.2.2",
    "deepmerge-ts": "^8.0.1",
    "mysql2": "^3.22.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "msgpackr-extract@3.0.0": true,
    "msgpackr-extract@3.0.4": true,
    "@scarf/scarf@1.4.0": false
  }
}
