generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?
  isActive     Boolean  @default(true)

  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id])

  oauthAccounts OAuthAccount[]
  refreshTokens RefreshToken[]
  workflowInstancesStarted WorkflowInstance[] @relation("WorkflowInstanceStartedBy")
  workflowHistoryActions WorkflowHistory[] @relation("WorkflowHistoryActor")
  auditLogs AuditLog[] @relation("AuditLogActor")
  formSubmissions FormSubmission[] @relation("FormSubmissionSubmittedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  provider          String
  providerAccountId String
  userId            Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?

  users       User[]
  permissions RolePermission[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Module {
  id          Int          @id @default(autoincrement())
  key         String       @unique
  name        String
  description String?

  permissions Permission[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Permission {
  id          Int              @id @default(autoincrement())
  moduleId    Int
  action      String

  module      Module           @relation(fields: [moduleId], references: [id])
  roles       RolePermission[]

  createdAt DateTime @default(now())

  @@unique([moduleId, action])
  @@index([moduleId])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id String @id

  tokenHash String @unique

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  replacedByTokenId String? @unique

  replacedByToken RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id])
  replacesToken   RefreshToken? @relation("RefreshTokenReplacement")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([replacedByTokenId])
}

model Workflow {
  id          String @id @default(uuid())
  key         String @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  versions WorkflowVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowVersion {
  id         String @id @default(uuid())
  workflowId String
  version    Int
  status     String @default("DRAFT")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps WorkflowStep[]
  transitions WorkflowTransition[]
  instances WorkflowInstance[]
  formRequirements DocumentRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowId, version])
  @@index([workflowId, status])
}

model WorkflowStep {
  id               String @id @default(uuid())
  workflowVersionId String
  key              String
  name             String
  description      String?
  sortOrder        Int @default(0)
  isInitial        Boolean @default(false)
  isFinal          Boolean @default(false)

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  outgoingTransitions WorkflowTransition[] @relation("WorkflowTransitionFrom")
  incomingTransitions WorkflowTransition[] @relation("WorkflowTransitionTo")
  currentInstances WorkflowInstance[]
  historyFrom WorkflowHistory[] @relation("WorkflowHistoryFrom")
  historyTo WorkflowHistory[] @relation("WorkflowHistoryTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowVersionId, key])
  @@index([workflowVersionId, sortOrder])
}

model WorkflowTransition {
  id               String @id @default(uuid())
  workflowVersionId String
  fromStepId       String
  toStepId         String
  key              String
  name             String
  description      String?
  permissionKey    String?

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  fromStep WorkflowStep @relation("WorkflowTransitionFrom", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStep WorkflowStep @relation("WorkflowTransitionTo", fields: [toStepId], references: [id], onDelete: Cascade)
  history WorkflowHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowVersionId, key])
  @@index([fromStepId])
  @@index([toStepId])
}

model WorkflowInstance {
  id               String @id @default(uuid())
  workflowVersionId String
  currentStepId    String
  subjectType      String
  subjectId        String
  startedByUserId  Int?
  startedAt        DateTime @default(now())
  completedAt      DateTime?

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id])
  currentStep WorkflowStep @relation(fields: [currentStepId], references: [id])
  startedBy User? @relation("WorkflowInstanceStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  history WorkflowHistory[]

  @@index([subjectType, subjectId])
  @@index([workflowVersionId])
  @@index([currentStepId])
}

model WorkflowHistory {
  id          String @id @default(uuid())
  instanceId  String
  fromStepId  String?
  toStepId    String
  transitionId String?
  actorId     Int?
  metadata    Json?
  createdAt   DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  fromStep WorkflowStep? @relation("WorkflowHistoryFrom", fields: [fromStepId], references: [id], onDelete: SetNull)
  toStep WorkflowStep @relation("WorkflowHistoryTo", fields: [toStepId], references: [id], onDelete: Restrict)
  transition WorkflowTransition? @relation(fields: [transitionId], references: [id], onDelete: SetNull)
  actor User? @relation("WorkflowHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([instanceId, createdAt])
  @@index([actorId])
}

model AuditLog {
  id         String @id @default(uuid())
  actorId    Int?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Form {
  id          String @id @default(uuid())
  key         String @unique
  name        String
  description String?
  entityType  String?
  isActive    Boolean @default(true)

  versions FormVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormVersion {
  id       String @id @default(uuid())
  formId   String
  version  Int
  status   String @default("DRAFT")

  form       Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  sections  FormSection[]
  fields    FormField[]
  submissions FormSubmission[]
  documentRequirements DocumentRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formId, version])
  @@index([formId, status])
}

model FormSection {
  id            String @id @default(uuid())
  formVersionId String
  key           String
  title         String
  description   String?
  sortOrder     Int @default(0)
  visibility    Json?

  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  fields FormField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formVersionId, key])
  @@index([formVersionId, sortOrder])
}

model FormField {
  id            String @id @default(uuid())
  formVersionId String
  sectionId     String?
  key           String
  label         String
  description   String?
  type          String
  sortOrder     Int @default(0)
  required      Boolean @default(false)
  defaultValue  Json?
  validation    Json?
  visibility    Json?
  config        Json?

  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  section FormSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  options FormOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formVersionId, key])
  @@index([formVersionId, sortOrder])
  @@index([sectionId, sortOrder])
}

model FormOption {
  id       String @id @default(uuid())
  fieldId  String
  value    String
  label    String
  sortOrder Int @default(0)
  metadata Json?

  field FormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, value])
  @@index([fieldId, sortOrder])
}

model FormSubmission {
  id            String @id @default(uuid())
  formVersionId String
  subjectType   String?
  subjectId     String?
  submittedByUserId Int?
  status        String @default("DRAFT")
  values        Json
  validationErrors Json?
  submittedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  submittedBy User? @relation("FormSubmissionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@index([formVersionId, status])
  @@index([subjectType, subjectId])
  @@index([submittedByUserId, createdAt])
}

model DocumentType {
  id          String @id @default(uuid())
  key         String @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  requirements DocumentRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentRequirement {
  id              String @id @default(uuid())
  documentTypeId  String
  formVersionId   String?
  workflowVersionId String?
  fieldKey        String?
  name            String
  description     String?
  required        Boolean @default(true)
  allowedFileTypes String[]
  maxSizeBytes    BigInt?
  condition       Json?
  source          String @default("CLIENT")
  sortOrder       Int @default(0)

  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  formVersion FormVersion? @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion? @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentTypeId])
  @@index([formVersionId, sortOrder])
  @@index([workflowVersionId, sortOrder])
}
