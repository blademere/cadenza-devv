generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  passwordHash String?
  isActive Boolean @default(true)
  roleId Int
  role Role @relation(fields: [roleId], references: [id])
  oauthAccounts OAuthAccount[]
  refreshTokens RefreshToken[]
  workflowInstancesStarted WorkflowInstance[] @relation("WorkflowInstanceStartedBy")
  workflowHistoryActions WorkflowHistory[] @relation("WorkflowHistoryActor")
  auditLogs AuditLog[] @relation("AuditLogActor")
  formSubmissions FormSubmission[] @relation("FormSubmissionSubmittedBy")
  approvalRequests ApprovalRequest[] @relation("ApprovalRequestAssignee")
  approvalActions ApprovalRequest[] @relation("ApprovalRequestActor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([roleId])
}

model OAuthAccount {
  id String @id @default(uuid())
  provider String
  providerAccountId String
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Role {
  id Int @id @default(autoincrement())
  name String @unique
  description String?
  users User[]
  permissions RolePermission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Module { id Int @id @default(autoincrement()); key String @unique; name String; description String?; permissions Permission[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Permission { id Int @id @default(autoincrement()); moduleId Int; action String; module Module @relation(fields: [moduleId], references: [id]); roles RolePermission[]; createdAt DateTime @default(now()); @@unique([moduleId, action]); @@index([moduleId]) }
model RolePermission { roleId Int; permissionId Int; role Role @relation(fields: [roleId], references: [id], onDelete: Cascade); permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade); createdAt DateTime @default(now()); @@id([roleId, permissionId]); @@index([permissionId]) }
model RefreshToken { id String @id; tokenHash String @unique; userId Int; user User @relation(fields: [userId], references: [id], onDelete: Cascade); expiresAt DateTime; revokedAt DateTime?; replacedByTokenId String? @unique; replacedByToken RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id]); replacesToken RefreshToken? @relation("RefreshTokenReplacement"); createdAt DateTime @default(now()); @@index([userId]); @@index([expiresAt]); @@index([revokedAt]); @@index([replacedByTokenId]) }

model Workflow { id String @id @default(uuid()); key String @unique; name String; description String?; isActive Boolean @default(true); versions WorkflowVersion[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model WorkflowVersion { id String @id @default(uuid()); workflowId String; version Int; status String @default("DRAFT"); workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade); steps WorkflowStep[]; transitions WorkflowTransition[]; instances WorkflowInstance[]; formRequirements DocumentRequirement[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([workflowId, version]); @@index([workflowId, status]) }
model WorkflowStep { id String @id @default(uuid()); workflowVersionId String; key String; name String; description String?; sortOrder Int @default(0); isInitial Boolean @default(false); isFinal Boolean @default(false); workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade); outgoingTransitions WorkflowTransition[] @relation("WorkflowTransitionFrom"); incomingTransitions WorkflowTransition[] @relation("WorkflowTransitionTo"); currentInstances WorkflowInstance[]; historyFrom WorkflowHistory[] @relation("WorkflowHistoryFrom"); historyTo WorkflowHistory[] @relation("WorkflowHistoryTo"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([workflowVersionId, key]); @@index([workflowVersionId, sortOrder]) }
model WorkflowTransition { id String @id @default(uuid()); workflowVersionId String; fromStepId String; toStepId String; key String; name String; description String?; permissionKey String?; workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade); fromStep WorkflowStep @relation("WorkflowTransitionFrom", fields: [fromStepId], references: [id], onDelete: Cascade); toStep WorkflowStep @relation("WorkflowTransitionTo", fields: [toStepId], references: [id], onDelete: Cascade); history WorkflowHistory[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([workflowVersionId, key]); @@index([fromStepId]); @@index([toStepId]) }
model WorkflowInstance { id String @id @default(uuid()); workflowVersionId String; currentStepId String; subjectType String; subjectId String; startedByUserId Int?; startedAt DateTime @default(now()); completedAt DateTime?; workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id]); currentStep WorkflowStep @relation(fields: [currentStepId], references: [id]); startedBy User? @relation("WorkflowInstanceStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull); history WorkflowHistory[]; @@index([subjectType, subjectId]); @@index([workflowVersionId]); @@index([currentStepId]) }
model WorkflowHistory { id String @id @default(uuid()); instanceId String; fromStepId String?; toStepId String; transitionId String?; actorId Int?; metadata Json?; createdAt DateTime @default(now()); instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade); fromStep WorkflowStep? @relation("WorkflowHistoryFrom", fields: [fromStepId], references: [id], onDelete: SetNull); toStep WorkflowStep @relation("WorkflowHistoryTo", fields: [toStepId], references: [id], onDelete: Restrict); transition WorkflowTransition? @relation(fields: [transitionId], references: [id], onDelete: SetNull); actor User? @relation("WorkflowHistoryActor", fields: [actorId], references: [id], onDelete: SetNull); @@index([instanceId, createdAt]); @@index([actorId]) }
model AuditLog { id String @id @default(uuid()); actorId Int?; action String; entityType String; entityId String; before Json?; after Json?; metadata Json?; ipAddress String?; userAgent String?; createdAt DateTime @default(now()); actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull); @@index([entityType, entityId, createdAt]); @@index([actorId, createdAt]); @@index([action, createdAt]) }

model Form { id String @id @default(uuid()); key String @unique; name String; description String?; entityType String?; isActive Boolean @default(true); versions FormVersion[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model FormVersion { id String @id @default(uuid()); formId String; version Int; status String @default("DRAFT"); form Form @relation(fields: [formId], references: [id], onDelete: Cascade); sections FormSection[]; fields FormField[]; submissions FormSubmission[]; documentRequirements DocumentRequirement[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([formId, version]); @@index([formId, status]) }
model FormSection { id String @id @default(uuid()); formVersionId String; key String; title String; description String?; sortOrder Int @default(0); visibility Json?; formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade); fields FormField[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([formVersionId, key]); @@index([formVersionId, sortOrder]) }
model FormField { id String @id @default(uuid()); formVersionId String; sectionId String?; key String; label String; description String?; type String; sortOrder Int @default(0); required Boolean @default(false); defaultValue Json?; validation Json?; visibility Json?; config Json?; formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade); section FormSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull); options FormOption[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([formVersionId, key]); @@index([formVersionId, sortOrder]); @@index([sectionId, sortOrder]) }
model FormOption { id String @id @default(uuid()); fieldId String; value String; label String; sortOrder Int @default(0); metadata Json?; field FormField @relation(fields: [fieldId], references: [id], onDelete: Cascade); @@unique([fieldId, value]); @@index([fieldId, sortOrder]) }
model FormSubmission { id String @id @default(uuid()); formVersionId String; subjectType String?; subjectId String?; submittedByUserId Int?; status String @default("DRAFT"); values Json; validationErrors Json?; submittedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict); submittedBy User? @relation("FormSubmissionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull); @@index([formVersionId, status]); @@index([subjectType, subjectId]); @@index([submittedByUserId, createdAt]) }
model DocumentType { id String @id @default(uuid()); key String @unique; name String; description String?; isActive Boolean @default(true); requirements DocumentRequirement[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model DocumentRequirement { id String @id @default(uuid()); documentTypeId String; formVersionId String?; workflowVersionId String?; fieldKey String?; name String; description String?; required Boolean @default(true); allowedFileTypes String[]; maxSizeBytes BigInt?; condition Json?; source String @default("CLIENT"); sortOrder Int @default(0); documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict); formVersion FormVersion? @relation(fields: [formVersionId], references: [id], onDelete: Cascade); workflowVersion WorkflowVersion? @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([documentTypeId]); @@index([formVersionId, sortOrder]); @@index([workflowVersionId, sortOrder]) }

model BusinessRule {
  id String @id @default(uuid())
  key String @unique
  name String
  description String?
  event String
  entityType String?
  priority Int @default(100)
  active Boolean @default(true)
  conditions Json
  actions Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([event, active, priority])
  @@index([entityType, event])
}
model ApprovalPolicy { id String @id @default(uuid()); key String @unique; name String; description String?; entityType String; priority Int @default(100); active Boolean @default(true); conditions Json; steps ApprovalStep[]; instances ApprovalInstance[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([entityType, active, priority]) }
model ApprovalStep { id String @id @default(uuid()); policyId String; stepOrder Int; name String; approverType String; approverValue String?; requiredCount Int @default(1); policy ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade); requests ApprovalRequest[]; @@unique([policyId, stepOrder]) }
model ApprovalInstance { id String @id @default(uuid()); policyId String; subjectType String; subjectId String; status String @default("PENDING"); currentStepOrder Int @default(1); completedAt DateTime?; policy ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict); requests ApprovalRequest[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([subjectType, subjectId, status]); @@index([policyId, status]) }
model ApprovalRequest { id String @id @default(uuid()); instanceId String; stepId String; assigneeUserId Int?; status String @default("PENDING"); comment String?; actedByUserId Int?; actedAt DateTime?; instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade); step ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Restrict); assignee User? @relation("ApprovalRequestAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull); actedBy User? @relation("ApprovalRequestActor", fields: [actedByUserId], references: [id], onDelete: SetNull); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([instanceId, status]); @@index([assigneeUserId, status]) }
model NotificationTemplate { id String @id @default(uuid()); key String @unique; name String; channel String; subject String?; body String; active Boolean @default(true); rules NotificationRule[]; deliveries NotificationDelivery[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model NotificationRule { id String @id @default(uuid()); key String @unique; name String; event String; entityType String?; active Boolean @default(true); priority Int @default(100); conditions Json; templateId String; recipientType String; recipientValue String?; template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict); deliveries NotificationDelivery[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([event, active, priority]) }
model NotificationDelivery { id String @id @default(uuid()); ruleId String; templateId String; recipient String; channel String; status String @default("QUEUED"); payload Json?; sentAt DateTime?; failedAt DateTime?; error String?; rule NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade); template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([status, createdAt]); @@index([recipient, createdAt]) }
model SlaPolicy { id String @id @default(uuid()); key String @unique; name String; entityType String; workflowStepKey String?; durationSeconds Int; warningSeconds Int?; escalationSeconds Int?; active Boolean @default(true); conditions Json; instances SlaInstance[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([entityType, active]) }
model SlaInstance { id String @id @default(uuid()); policyId String; subjectType String; subjectId String; status String @default("RUNNING"); startedAt DateTime @default(now()); warningAt DateTime?; dueAt DateTime; escalatedAt DateTime?; completedAt DateTime?; policy SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([subjectType, subjectId, status]); @@index([status, dueAt]); @@index([status, warningAt]) }

model CustomFieldDefinition {
  id String @id @default(uuid())
  entityType String
  key String
  label String
  description String?
  type String
  required Boolean @default(false)
  active Boolean @default(true)
  sortOrder Int @default(0)
  config Json?
  values CustomFieldValue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([entityType, key])
  @@index([entityType, active, sortOrder])
}
model CustomFieldValue {
  id String @id @default(uuid())
  definitionId String
  entityType String
  entityId String
  value Json
  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([definitionId, entityId])
  @@index([entityType, entityId])
}

model Dashboard {
  id String @id @default(uuid())
  key String @unique
  name String
  description String?
  active Boolean @default(true)
  config Json?
  widgets DashboardWidget[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model DashboardWidget {
  id String @id @default(uuid())
  dashboardId String
  key String
  type String
  title String
  description String?
  sortOrder Int @default(0)
  permissionKey String?
  config Json
  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([dashboardId, key])
  @@index([dashboardId, sortOrder])
}

model Integration {
  id String @id @default(uuid())
  key String @unique
  name String
  type String
  active Boolean @default(true)
  config Json?
  secretRef String?
  events IntegrationEvent[]
  webhooks WebhookEndpoint[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([type, active])
}
model IntegrationEvent {
  id String @id @default(uuid())
  integrationId String
  event String
  active Boolean @default(true)
  config Json?
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([integrationId, event])
  @@index([event, active])
}
model WebhookEndpoint {
  id String @id @default(uuid())
  integrationId String?
  key String @unique
  name String
  url String
  secretRef String?
  events String[]
  headers Json?
  active Boolean @default(true)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active])
}
model WebhookDelivery {
  id String @id @default(uuid())
  endpointId String
  event String
  entityType String?
  entityId String?
  payload Json
  status String @default("QUEUED")
  attempts Int @default(0)
  nextAttemptAt DateTime?
  sentAt DateTime?
  lastError String?
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}
