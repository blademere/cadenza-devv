model Person {
  id String @id @default(uuid())
  userId Int? @unique
  firstName String
  middleName String?
  lastName String
  suffix String?
  email String?
  phone String?
  address Json?
  metadata Json?
  isActive Boolean @default(true)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  caseParticipants CaseParticipant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([lastName, firstName])
  @@index([email])
  @@index([isActive])
}

model CaseType {
  id String @id @default(uuid())
  key String @unique
  name String
  description String?
  isActive Boolean @default(true)
  cases CaseRecord[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive])
}

model CaseRecord {
  id String @id @default(uuid())
  caseNumber String @unique
  caseTypeId String
  title String
  description String?
  status String @default("DRAFT")
  openedAt DateTime @default(now())
  closedAt DateTime?
  createdByUserId Int?
  metadata Json?
  caseType CaseType @relation(fields: [caseTypeId], references: [id], onDelete: Restrict)
  createdByUser User? @relation("CaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  statusHistory CaseStatusHistory[]
  participants CaseParticipant[]
  requirements CaseRequirement[]
  tasks Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([caseTypeId, status])
  @@index([status, createdAt])
  @@index([createdByUserId])
}

model CaseStatusHistory {
  id String @id @default(uuid())
  caseId String
  fromStatus String?
  toStatus String
  reason String?
  changedByUserId Int?
  metadata Json?
  caseRecord CaseRecord @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedByUser User? @relation("CaseStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([caseId, createdAt])
  @@index([changedByUserId])
}

model CaseParticipant {
  id String @id @default(uuid())
  caseId String
  personId String
  roleKey String
  isPrimary Boolean @default(false)
  metadata Json?
  caseRecord CaseRecord @relation(fields: [caseId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([caseId, personId, roleKey])
  @@index([caseId, roleKey])
  @@index([personId])
}

model RequirementDefinition {
  id String @id @default(uuid())
  key String @unique
  name String
  description String?
  isActive Boolean @default(true)
  metadata Json?
  caseRequirements CaseRequirement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive])
}

model CaseRequirement {
  id String @id @default(uuid())
  caseId String
  requirementId String
  status String @default("PENDING")
  dueAt DateTime?
  submittedAt DateTime?
  verifiedAt DateTime?
  notes String?
  metadata Json?
  caseRecord CaseRecord @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requirement RequirementDefinition @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([caseId, requirementId])
  @@index([caseId, status])
  @@index([requirementId])
}

model Task {
  id String @id @default(uuid())
  caseId String?
  title String
  description String?
  status String @default("OPEN")
  priority String @default("NORMAL")
  assigneeUserId Int?
  createdByUserId Int?
  dueAt DateTime?
  completedAt DateTime?
  metadata Json?
  caseRecord CaseRecord? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assigneeUser User? @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdByUser User? @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([caseId, status])
  @@index([assigneeUserId, status])
  @@index([status, dueAt])
}
