model NotificationTemplate {
  id         String                 @id @default(uuid())
  key        String                 @unique
  name       String
  channel    String
  subject    String?
  body       String
  active     Boolean                @default(true)
  rules      NotificationRule[]
  deliveries NotificationDelivery[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
}

model NotificationRule {
  id             String                 @id @default(uuid())
  key            String                 @unique
  name           String
  event          String
  entityType     String?
  active         Boolean                @default(true)
  priority       Int                    @default(100)
  conditions     Json
  templateId     String
  recipientType  String
  recipientValue String?
  template       NotificationTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  deliveries     NotificationDelivery[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([event, active, priority])
}

model NotificationDelivery {
  id             String                @id @default(uuid())
  ruleId         String?
  templateId     String?
  notificationId String?
  recipient      String
  channel        String
  status         String                @default("QUEUED")
  idempotencyKey String                @unique
  payload        Json?
  sentAt         DateTime?
  failedAt       DateTime?
  error          String?
  rule           NotificationRule?     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  template       NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  notification   Notification?         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([recipient, createdAt])
  @@index([notificationId, channel])
}
