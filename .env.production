# Server Configuration
NODE_ENV=production
PORT=3000
CORS_ORIGIN="https://your-frontend.example.com"

# PostgreSQL Configuration
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=express_app
POSTGRES_PORT=5432

DATABASE_URL="postgresql://change_me:change_me@db:5432/express_app?schema=public"

# Redis Configuration
REDIS_PORT=6379
# Inside Docker networking, host is 'redis'
REDIS_URL="redis://redis:6379"

# Authentication & Security (JWT)
# Generate unique cryptographically-random secrets for production.
JWT_ACCESS_SECRET="replace_with_a_unique_random_secret_at_least_32_characters"
JWT_REFRESH_SECRET="replace_with_a_unique_random_secret_at_least_32_characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OAuth State Security
# Generate a unique cryptographically-random secret for production.
OAUTH_STATE_SECRET="replace_with_a_unique_random_oauth_state_secret_at_least_32_characters"

# OAuth Provider Configuration
# Leave provider variables unset if that provider is not enabled.
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_GOOGLE_CALLBACK_URL="https://your-api.example.com/api/v1/auth/oauth/google/callback"

OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""
OAUTH_GITHUB_CALLBACK_URL="https://your-api.example.com/api/v1/auth/oauth/github/callback"

# OAuth Application Configuration
OAUTH_DEFAULT_ROLE_NAME="client"
OAUTH_FRONTEND_SUCCESS_URL="https://your-frontend.example.com/auth/callback/success"
OAUTH_FRONTEND_FAILURE_URL="https://your-frontend.example.com/auth/callback/failure"

# Cookies
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=""
COOKIE_REFRESH_MAX_AGE_MS=604800000

# pgAdmin Management
# Prefer keeping pgAdmin credentials outside the application environment in production.
PGADMIN_DEFAULT_EMAIL="admin@example.com"
PGADMIN_DEFAULT_PASSWORD="replace_with_a_unique_strong_password"
