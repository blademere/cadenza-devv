# Server Configuration
NODE_ENV=production
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# PostgreSQL Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=express_app
POSTGRES_PORT=5432

DATABASE_URL="postgresql://user:password@db:5432/express_app?schema=public"

# Redis Configuration
REDIS_PORT=6379
# Inside Docker networking, host is 'redis'
REDIS_URL="redis://redis:6379"

# Authentication & Security (JWT)
JWT_ACCESS_SECRET="super-secret-access-token-key-min-32-chars-long"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookies
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_REFRESH_MAX_AGE_MS=604800000

# pgAdmin Management
PGADMIN_DEFAULT_EMAIL="admin@example.com"
PGADMIN_DEFAULT_PASSWORD="adminpassword"