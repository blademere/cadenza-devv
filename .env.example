# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
# Used by local development outside the Dev Container.
DATABASE_URL=postgresql://user:password@localhost:5432/express_app?schema=public
# Used by the Dev Container Compose services.
DEV_DATABASE_NAME=express_app
DEV_POSTGRES_USER=user
DEV_POSTGRES_PASSWORD=password

# Redis
REDIS_URL=redis://redis:6379

# Object storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# API cache
API_CACHE_TTL_SECONDS=60

# Authentication & Security
JWT_ACCESS_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_URL=http://localhost:5173/auth/reset-password?token=
EMAIL_VERIFICATION_URL=http://localhost:5173/auth/verify-email?token=

# Metrics endpoint protection (required in production)
METRICS_TOKEN=754183cac8af584f7aca865337d5e69c65cb5bb4f4e5ee9756dd1829b47ed935

# Development seed (optional)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Cadenza development admin seed (optional)
SEED_CADENZA_ADMIN_EMAIL=cadenza-admin@example.com
SEED_CADENZA_ADMIN_PASSWORD=

# OAuth Provider Configuration
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/facebook/callback
OAUTH_FACEBOOK_API_VERSION=v24.0
OAUTH_DEFAULT_ROLE_NAME=client
OAUTH_FRONTEND_SUCCESS_URL=http://localhost:5173/auth/callback/success
OAUTH_FRONTEND_FAILURE_URL=http://localhost:5173/auth/callback/failure

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_REFRESH_MAX_AGE_MS=604800000


# Xendit Payments (optional)
# Configure both credentials together to enable Xendit payment flows.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_API_VERSION=2024-11-11
XENDIT_COUNTRY=PH
XENDIT_CHANNEL_CODE=GCASH
XENDIT_SUCCESS_URL=http://localhost:5173/payment/success
XENDIT_FAILURE_URL=http://localhost:5173/payment/failure
CADENZA_PAYMENT_PROVIDER=XENDIT

# Authorization cache
AUTHORIZATION_CACHE_ENABLED=true
AUTHORIZATION_CACHE_TRUST_POSITIVE=false

# Monitoring
SENTRY_DSN=

# Same-origin development: Vite proxies /api to the local Express server.
VITE_API_BASE_URL=/api/v1

# Vite dev-server proxy target.
# When Vite and Express run in the same development container/host, keep localhost.
# When Vite runs in a separate container, use the Express service hostname instead.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Codespaces / split frontend-backend deployments:
# Set VITE_API_BASE_URL to the HTTPS backend origin so browser cookies are
# stored and sent directly to the API host instead of being hidden behind
# the frontend Vite proxy.
# Example:
# VITE_API_BASE_URL=https://<codespace-backend>.app.github.dev/api/v1
