# Application
NODE_ENV=development
APP_NAME=Express App
APP_SLUG=express-app
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
# Used by local development outside the Dev Container.
DATABASE_URL=postgresql://user:password@localhost:5432/express_app?schema=public
# Used by the Dev Container Compose services.
DEV_DATABASE_NAME=express_app
DEV_POSTGRES_USER=user
DEV_POSTGRES_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379

# Document storage
# Local adapter path. Use an absolute path or a project-relative path.
DOCUMENT_STORAGE_DIR=./storage/documents

# Authentication & Security
JWT_ACCESS_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Metrics endpoint protection (required in production)
METRICS_TOKEN=replace_with_a_unique_random_token_at_least_32_characters

# Development seed (optional)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# OAuth Provider Configuration
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback

OAUTH_DEFAULT_ROLE_NAME=client
OAUTH_FRONTEND_SUCCESS_URL=http://localhost:5173/auth/callback/success
OAUTH_FRONTEND_FAILURE_URL=http://localhost:5173/auth/callback/failure

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_REFRESH_MAX_AGE_MS=604800000

# Monitoring
SENTRY_DSN=
