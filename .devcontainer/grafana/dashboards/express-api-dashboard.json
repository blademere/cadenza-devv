      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "lineWidth": 2,
          "fillOpacity": 15
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
