      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "lineWidth": 2,
          "fillOpacity": 15
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
