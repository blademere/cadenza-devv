        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{status_code=~\"5..\"}[1h]))",
          "legendFormat": "5xx"
